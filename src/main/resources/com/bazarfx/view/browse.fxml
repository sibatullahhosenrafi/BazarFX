<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bazarfx.controller.BrowseController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Search listings..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter" prefWidth="150.0"/>
        <Button onAction="#onSearch" styleClass="primary-button" text="Search"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="220.0" text="Title"/>
            <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category"/>
            <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price"/>
            <TableColumn fx:id="conditionColumn" prefWidth="100.0" text="Condition"/>
            <TableColumn fx:id="sellerColumn" prefWidth="120.0" text="Seller"/>
        </columns>
    </TableView>

    <Button onAction="#onViewSelected" styleClass="secondary-button" text="View Selected Listing"/>
</VBox>
