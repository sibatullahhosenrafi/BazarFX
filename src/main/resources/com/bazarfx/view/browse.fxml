<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="browse-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bazarfx.controller.BrowseController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Search listings..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter" prefWidth="150.0"/>
        <Button onAction="#onSearch" styleClass="primary-button" text="Search"/>
    </HBox>

    <Label fx:id="resultsCountLabel" styleClass="results-count"/>

    <ScrollPane fitToWidth="true" styleClass="products-scroll" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="productGrid" hgap="18.0" vgap="18.0" styleClass="product-grid"/>
    </ScrollPane>
</VBox>
