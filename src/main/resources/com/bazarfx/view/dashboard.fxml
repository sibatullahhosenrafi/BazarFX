<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bazarfx.controller.DashboardController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label styleClass="panel-title" text="My Listings"/>
    <ListView fx:id="myListingsView" prefHeight="160.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="panel-title" text="Marketplace Report"/>
        <ProgressIndicator fx:id="reportProgress" prefHeight="24.0" prefWidth="24.0"/>
    </HBox>
    <Button onAction="#onGenerateReport" styleClass="secondary-button" text="Generate Report"/>

    <Label fx:id="revenueLabel"/>
    <Label fx:id="topCategoryLabel"/>
    <Label fx:id="topSellerLabel"/>
    <Label fx:id="totalOrdersLabel"/>
</VBox>
