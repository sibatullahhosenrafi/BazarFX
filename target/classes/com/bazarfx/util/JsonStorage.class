public class JsonStorage {
    private static final Gson GSON = (new GsonBuilder()).setPrettyPrinting().create();
    private static final Object LOCK = new Object();
    public static final String DATA_DIR = "data";

    public static <T> List<T> loadList(String fileName, Type listType) {
        synchronized(LOCK) {
            Path path = Path.of("data", fileName);
            if (!Files.exists(path, new LinkOption[0])) {
                return new ArrayList();
            } else {
                Object var6;
                try {
                    FileReader reader = new FileReader(path.toFile());

                    try {
                        List<T> result = (List)GSON.fromJson(reader, listType);
                        var6 = result != null ? result : new ArrayList();
                    } catch (Throwable var9) {
                        try {
                            reader.close();
                        } catch (Throwable var8) {
                            var9.addSuppressed(var8);
                        }

                        throw var9;
                    }

                    reader.close();
                } catch (IOException e) {
                    System.err.println("Failed to load " + fileName + ": " + e.getMessage());
                    return new ArrayList();
                }

                return (List<T>)var6;
            }
        }
    }

    public static <T> void saveList(String fileName, List<T> list) {
        synchronized(LOCK) {
            Path path = Path.of("data", fileName);

            try {
                FileWriter writer = new FileWriter(path.toFile());

                try {
                    GSON.toJson(list, writer);
                } catch (Throwable var9) {
                    try {
                        writer.close();
                    } catch (Throwable var8) {
                        var9.addSuppressed(var8);
                    }

                    throw var9;
                }

                writer.close();
            } catch (IOException e) {
                System.err.println("Failed to save " + fileName + ": " + e.getMessage());
            }

        }
    }

    static {
        try {
            Files.createDirectories(Path.of("data"));
            Files.createDirectories(Path.of("data", "images"));
        } catch (IOException e) {
            throw new RuntimeException("Could not create data directory", e);
        }
    }
}
