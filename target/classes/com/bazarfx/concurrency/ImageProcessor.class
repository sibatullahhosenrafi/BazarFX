package com.bazarfx.concurrency;

import java.io.File;
import java.io.IOException;
import java.io.PrintStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.util.List;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.Consumer;
import javafx.application.Platform;

public class ImageProcessor {
    private final ExecutorService pool = Executors.newFixedThreadPool(3, (r) -> {
        Thread t = new Thread(r, "image-worker");
        t.setDaemon(true);
        return t;
    });

    public void processImages(String productId, List<File> sourceFiles, Consumer<String> onEachSaved, Runnable onAllDone) {
        AtomicInteger remaining = new AtomicInteger(sourceFiles.size());
        if (sourceFiles.isEmpty()) {
            onAllDone.run();
        } else {
            for(File file : sourceFiles) {
                this.pool.submit(() -> {
                    try {
                        Path targetDir = Path.of("data", "images", productId);
                        Files.createDirectories(targetDir);
                        Thread.sleep(300L);
                        Path target = targetDir.resolve(file.getName());
                        Files.copy(file.toPath(), target, StandardCopyOption.REPLACE_EXISTING);
                        String relativePath = target.toString();
                        Platform.runLater(() -> onEachSaved.accept(relativePath));
                    } catch (InterruptedException | IOException e) {
                        PrintStream var10000 = System.err;
                        String var10001 = file.getName();
                        var10000.println("Image processing failed for " + var10001 + ": " + ((Exception)e).getMessage());
                    } finally {
                        if (remaining.decrementAndGet() == 0) {
                            Platform.runLater(onAllDone);
                        }

                    }

                });
            }

        }
    }

    public void shutdown() {
        this.pool.shutdown();
    }
}
