<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bazarfx.controller.SellController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label styleClass="panel-title" text="Sell an Item"/>

    <TextField fx:id="titleField" promptText="Title"/>
    <TextArea fx:id="descriptionField" prefRowCount="3" promptText="Description"/>

    <HBox spacing="10.0">
        <ComboBox fx:id="categoryField" prefWidth="180.0" promptText="Category"/>
        <ComboBox fx:id="conditionField" prefWidth="140.0" promptText="Condition"/>
        <TextField fx:id="priceField" promptText="Price (BDT)" HBox.hgrow="ALWAYS"/>
    </HBox>

    <TextField fx:id="locationField" promptText="Location"/>

    <HBox spacing="10.0">
        <Button onAction="#onChoosePhotos" styleClass="secondary-button" text="Choose Photos (max 5)"/>
        <ProgressIndicator fx:id="progressIndicator" prefHeight="26.0" prefWidth="26.0"/>
    </HBox>
    <ListView fx:id="chosenPhotosList" prefHeight="80.0"/>

    <Button maxWidth="Infinity" onAction="#onPublish" styleClass="primary-button" text="Publish Listing"/>
    <Label fx:id="statusLabel" styleClass="status-label"/>
</VBox>
