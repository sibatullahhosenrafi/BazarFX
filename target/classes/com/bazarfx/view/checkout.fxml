<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bazarfx.controller.CheckoutController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label styleClass="panel-title" text="Checkout (Simulated Purchase)"/>
    <Label fx:id="totalLabel" styleClass="price-label"/>
    <Button onAction="#onConfirmPurchase" styleClass="primary-button" text="Confirm Purchase"/>
    <Label fx:id="confirmationLabel" styleClass="status-label" wrapText="true"/>

    <Label styleClass="panel-title" text="Live Order Status"/>
    <ListView fx:id="orderStatusList" VBox.vgrow="ALWAYS"/>
</VBox>
